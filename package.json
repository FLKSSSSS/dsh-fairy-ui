    "unist-util-stringify-position": "4.0.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "ccount": "2.0.1",
    "mdast-util-find-and-replace": "3.0.2",
    "escape-string-regexp": "5.0.0",
